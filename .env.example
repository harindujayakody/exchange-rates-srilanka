# Copy to .env and fill in. .env is git-ignored; never commit a real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Telegram bot (optional). Create a bot with @BotFather and paste its token.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user ids allowed to see token usage. Send /myid to the bot to get yours.
# TELEGRAM_ADMIN_IDS=123456789

# API tokens for outside callers such as Hermes (optional, comma-separated).
# When set, /rates, /banks and /api/history need "Authorization: Bearer <token>" unless called from the web app itself.
# API_TOKENS=make-a-long-random-string

# Push agent for banks that block the server's IP (optional).
# On the server: PUSH_TOKEN (and PUSH_BANKS) stop it fetching those banks itself.
# On the home PC: PUSH_TO + the same PUSH_TOKEN; scripts/install-push-agent.ps1 fills both in.
# PUSH_TOKEN=long-random-shared-secret
# PUSH_BANKS=combank,boc,ntb
# PUSH_TO=https://rates.infiax.dev

# Daily Telegram post (optional): currency and 24-hour Sri Lanka time.
# DAILY_CURRENCY=USD
# DAILY_TIME=09:00

# Your public site address, printed on the bot's share images (optional).
# PUBLIC_URL=https://rates.example.com

# Optional
# PORT=5821
# HOST=127.0.0.1          # listen address; leave unset to listen on all interfaces
# REFRESH_HOURS=3
# OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# DATA_DIR=data
# TRUST_PROXY=1           # only behind a reverse proxy that sets X-Forwarded-For
